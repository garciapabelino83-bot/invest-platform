# Copia este archivo como ".env.local" y pega tu connection string de Neon.tech
# La encuentras en tu dashboard de Neon.tech -> tu proyecto "invest-platform" -> Connection Details

DATABASE_URL="postgresql://usuario:password@host.neon.tech/invest-platform?sslmode=require"

# --- Plan Pro / Stripe ---
# Claves de tu cuenta de Stripe (Developers -> API keys). En modo de prueba
# empiezan con sk_test_ / pk_test_; cuando actives la cuenta real, con sk_live_ / pk_live_.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ID del precio del Plan Pro (Catalogo de productos -> InvestPanel - Plan Pro).
# No es secreto, por eso puede ir con NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PRICE_ID="price_1UHG3D5K5zPIe416LUa31wu0"
